# ------------------------------------------------------------------ AI Job Hunter configuration
# Copy to .env and fill in what you need. Every value is optional — the app works with no AI key
# (deterministic templates are used for cover letters, messages and answers).

# --- Database (SQLite by default; PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/jobhunter)
# DATABASE_URL=sqlite:///./backend/data/jobhunter.db
# DATA_DIR=./backend/data

# --- Server
# APP_HOST=127.0.0.1
# APP_PORT=8000
# Protect the whole app with HTTP Basic auth (recommended if reachable from other devices)
# APP_USERNAME=me
# APP_PASSWORD=change-me

# --- AI provider: auto | anthropic | openai | google | ollama | none
AI_PROVIDER=auto
# AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Automation
# SCHEDULER_ENABLED=true          # in-process scheduler thread (times configured in Settings)
# HTTP_USER_AGENT=AIJobHunter/1.0 (personal job search assistant)

# --- Browser agent (Supervised mode; requires: pip install -r backend/requirements-browser.txt)
# BROWSER_HEADLESS=false          # keep false: you log in yourself / solve CAPTCHAs yourself
# BROWSER_USER_DATA_DIR=./backend/data/browser-profile
# BROWSER_EXECUTABLE_PATH=
